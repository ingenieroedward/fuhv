{
  "name": "fuhv-generator",
  "version": "1.0.0",
  "description": "Generador de Formato Único de Hoja de Vida (FUHV) de Colombia",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node server/index.js",
    "test": "NODE_ENV=test jest tests/ --verbose --runInBand",
    "test:unit": "NODE_ENV=test jest tests/validation.test.js --verbose",
