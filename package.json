    "express-rate-limit": "^8.3.1",
    "joi": "^18.0.2",
    "pdf-lib": "^1.17.1",
    "puppeteer": "^24.33.0"
  },
  "devDependencies": {
    "jest": "^30.3.0",
    "supertest": "^7.2.2"
  }
